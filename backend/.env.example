# TrustChain Backend — Environment Configuration
# Copy this file to .env and adjust values for your environment.

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=8080
SHUTDOWN_TIMEOUT=10

# ── MongoDB ────────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=trustchain
MONGODB_CONNECT_TIMEOUT=10

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Providers ──────────────────────────────────────────────────────────────────
# Blockchain: mock | polygon | hardhat
# Set to "hardhat" to connect to a local Hardhat node (requires deploy.js to have been run first).
BLOCKCHAIN_PROVIDER=hardhat

# Recommendation: mock | federated
RECOMMENDATION_PROVIDER=mock

# ── Hardhat (only used when BLOCKCHAIN_PROVIDER=hardhat) ───────────────────────
HARDHAT_RPC_URL=http://127.0.0.1:8545
# Path to the deployment JSON produced by:
#   cd contracts/trustchain-task6-s1 && npx hardhat run scripts/deploy.js --network localhost
HARDHAT_DEPLOYMENT_PATH=../contracts/trustchain-task6-s1/deployments/localhost.json
